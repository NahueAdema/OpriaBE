# Runtime
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# HTTP
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3000

# Logging (fatal | error | warn | info | debug | trace | silent)
LOG_LEVEL=debug

# Docs: defaults to true outside production
SWAGGER_ENABLED=true

# Rate limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Database (local Docker on 5433)
DATABASE_URL=postgres://opria:opria@127.0.0.1:5433/opria
# Unpooled connection for migrations. On Neon, use the URL without "-pooler".
DATABASE_URL_DIRECT=postgres://opria:opria@127.0.0.1:5433/opria
DATABASE_POOL_MAX=10

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=opria
JWT_AUDIENCE=opria-api

# Seed (optional overrides)
SEED_TENANT_SLUG=demo
SEED_OWNER_EMAIL=owner@opria.app
SEED_OWNER_PASSWORD=opria-demo-2026
